<idea-plugin>
    <id>dev.phptools.phpstan</id>
    <name>PHPStan Integration</name>
    <description><![CDATA[
    <p>PHPStan errors right in the OpenIDE editor: while typing, on save or on demand. Runs locally or via Docker Compose.
    Larastan is picked up automatically from the PHPStan configuration.</p>
    <p>Plugin for OpenIDE. JetBrains IDEs are not supported and not tested.</p>
    <p>Ошибки PHPStan прямо в редакторе OpenIDE: при вводе, при сохранении или по команде. Запуск локально или через Docker Compose.
    Larastan подхватывается из конфигурации PHPStan автоматически.</p>
    <p>Плагин для OpenIDE. Работа в IDE JetBrains не поддерживается и не тестируется.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Список изменённых файлов в панели берётся из VCS -->
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="phpstan" displayType="BALLOON"/>
        <!-- Windows: проект в WSL, а инструмент запускается локально — предложить WSL -->
        <postStartupActivity implementation="dev.phptools.phpstan.PhpStanWslSuggestion"/>
        <!-- Предлагает выключить встроенный в PHP-плагин анализатор, чтобы ошибки не дублировались -->
        <postStartupActivity implementation="dev.phptools.phpstan.PhpStanBuiltInCheck"/>

        <localInspection shortName="PhpStanInspection"
                         displayName="PHPStan validation"
                         groupName="PHP tools"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="dev.phptools.phpstan.PhpStanInspection"/>
        <externalAnnotator language="PHP" implementationClass="dev.phptools.phpstan.PhpStanAnnotator"/>
        <editorNotificationProvider implementation="dev.phptools.phpstan.PhpStanFileProblemsBanner"/>

        <projectConfigurable parentId="tools"
                             id="dev.phptools.phpstan"
                             displayName="PHPStan"
                             instance="dev.phptools.phpstan.PhpStanConfigurable"/>

        <!-- Панель: изменённые файлы и отчёт. Иконка — логотип PHPStan (MIT, см. icons/PHPSTAN-LOGO-LICENSE.txt) -->
        <toolWindow id="PHPStan"
                    anchor="left"
                    secondary="false"
                    icon="/icons/phpstan.png"
                    factoryClass="dev.phptools.phpstan.PhpStanToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="dev.phptools.phpstan.CheckWithPhpStan" class="dev.phptools.phpstan.PhpStanCheckAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="dev.phptools.core.annotator.RehighlightOnSave"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>
</idea-plugin>
